@model Geekspace.Models.LearningResource

@{
    ViewData["Title"] = Model.Title;
    var tocEntries = ViewBag.TocEntries as List<(int Level, string Text, string Id)> ?? new List<(int Level, string Text, string Id)>();
    var readingTimeMinutes = ViewBag.ReadingTimeMinutes as int? ?? 1;
    var shareUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}

<header class="python-article-hero">
    <h1>@Model.Title</h1>
    <p class="python-article-lead">@Model.Description</p>

    <div class="python-article-meta" aria-label="Resource information">
        <span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 5.5h16v13H4zM8 3v5M16 3v5M4 9h16"></path>
            </svg>
            @Model.CreatedDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
        </span>
        <span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="8"></circle>
                <path d="M12 8v4l3 2"></path>
            </svg>
            @readingTimeMinutes min read
        </span>
        <span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"></path>
            </svg>
            @(Model.Category?.Name ?? "Uncategorized")
        </span>
        <span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.59 13.41 13 21l-9-9V4h8l8.59 8.59a2 2 0 0 1 0 2.82Z"></path>
                <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            @Model.Type
        </span>
    </div>
</header>

<div class="resource-layout-shell">
    <div class="resource-body-column">
        @if (!string.IsNullOrWhiteSpace(Model.MediaUrl))
        {
            var extension = System.IO.Path.GetExtension(Model.MediaUrl).ToLowerInvariant();
            var videoExtensions = new[] { ".mp4", ".webm", ".ogg" };

            <div class="mb-4">
                @if (videoExtensions.Contains(extension))
                {
                    <video controls preload="metadata" style="max-width:100%; border-radius:6px;">
                        <source src="@Model.MediaUrl" type="video/@(extension.TrimStart('.'))" />
                        Your browser does not support the video tag.
                    </video>
                }
                else
                {
                    <figure class="figure text-center d-block">
                        <img src="@Model.MediaUrl" class="figure-img img-fluid rounded" alt="@Model.Title illustration" />
                        <figcaption class="figure-caption">@Model.Title</figcaption>
                    </figure>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.DownloadableFilePath))
        {
            var downloadFileName = System.IO.Path.GetFileName(Model.DownloadableFilePath);

            <a href="@Model.DownloadableFilePath" download class="download-bar">
                <svg class="download-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                <span class="download-filename">@downloadFileName</span>
            </a>
        }

        <div class="resource-content markdown-body">
            @Html.Raw((string)ViewBag.ContentHtml)
        </div>
    </div>

    @if (tocEntries.Count > 0)
    {
        <aside class="resource-toc-sidebar" aria-label="On this page">
            <p>On this page</p>
            <nav>
                @foreach (var entry in tocEntries)
                {
                    <a href="#@entry.Id" class="resource-toc-level-@entry.Level">@entry.Text</a>
                }
            </nav>
        </aside>
    }
</div>

<div class="mt-4 mb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Root"))
        {
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-primary">Edit</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="share-btn" id="copyLinkBtn" data-share-url="@shareUrl" title="Copy link" aria-label="Copy link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
            </svg>
        </button>
        <a class="share-btn" target="_blank" rel="noopener" title="Share on Telegram" aria-label="Share on Telegram"
           href="https://t.me/share/url?url=@Uri.EscapeDataString(shareUrl)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
        </a>
        <a class="share-btn" target="_blank" rel="noopener" title="Share on WhatsApp" aria-label="Share on WhatsApp"
           href="https://wa.me/?text=@Uri.EscapeDataString(shareUrl)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
        </a>
        <a class="share-btn" target="_blank" rel="noopener" title="Share on LinkedIn" aria-label="Share on LinkedIn"
           href="https://www.linkedin.com/sharing/share-offsite/?url=@Uri.EscapeDataString(shareUrl)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect x="2" y="9" width="4" height="12"></rect>
                <circle cx="4" cy="4" r="2"></circle>
            </svg>
        </a>
        <a class="share-btn share-btn-x" target="_blank" rel="noopener" title="Share on X" aria-label="Share on X"
           href="https://twitter.com/intent/tweet?url=@Uri.EscapeDataString(shareUrl)&text=@Uri.EscapeDataString(Model.Title)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
        </a>
    </div>
</div>

<hr />
<h3>Discussion (@Model.Comments.Count())</h3>

@if (TempData["CommentError"] != null)
{
    <div class="alert alert-danger">@TempData["CommentError"]</div>
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <form asp-controller="Comment" asp-action="Create" method="post" class="mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="learningResourceId" value="@Model.Id" />
        <div class="form-group">
            <textarea name="content" class="form-control" rows="3" placeholder="Share your thoughts..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Post Comment</button>
    </form>
}
else
{
    <p><a asp-area="Identity" asp-page="/Account/Login">Log in</a> to join the discussion.</p>
}

<partial name="_CommentList" model="Model.Comments.OrderByDescending(c => c.PostedDate)" />
