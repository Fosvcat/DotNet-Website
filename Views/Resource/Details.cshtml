@model Geekspace.Models.LearningResource
@using Geekspace.ViewModels

@{
    ViewData["Title"] = Model.Title;
    var isPythonSecurityArticle = Model.Title == "Python Scripting for Security Automation";
    var hasProfessionalLayout = isPythonSecurityArticle || ProfessionalResourceCatalog.Contains(Model.Title);
    IEnumerable<Geekspace.Models.ResourceComment> resourceComments =
        Model.Comments ?? Enumerable.Empty<Geekspace.Models.ResourceComment>();
}

@if (isPythonSecurityArticle)
{
    <partial name="_PythonSecurityArticle" model="Model" />
}
else if (ProfessionalResourceCatalog.Contains(Model.Title))
{
    <partial name="_ProfessionalResourceArticle" model="Model" />
}
else
{
    <partial name="_MarkdownResourceArticle" model="Model" />
}

<partial name="_ResourceReadingActions" model="Model" />

<div class="@(hasProfessionalLayout ? "python-community-shell" : "")">
<div class="site-page-actions mt-4 mb-2">
    @if (User.IsInRole("Admin") || User.IsInRole("Root"))
    {
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="site-action-btn site-action-edit">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
            </svg>
            <span>Edit</span>
        </a>
    }
    <a asp-action="Index" class="site-action-btn site-action-back">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 12H5M11 18l-6-6 6-6"></path>
        </svg>
        <span>Back to List</span>
    </a>
</div>

<hr />
<h3>Discussion (@resourceComments.Count())</h3>

@if (TempData["CommentError"] != null)
{
    <div class="alert alert-danger">@TempData["CommentError"]</div>
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <form asp-controller="Comment" asp-action="Create" method="post" class="mb-4">
        @Html.AntiForgeryToken()
        <input type="hidden" name="learningResourceId" value="@Model?.Id" />
        <div class="form-group">
            <textarea name="content" class="form-control" rows="3" placeholder="Share your thoughts..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Post Comment</button>
    </form>
}
else
{
    <p><a asp-area="Identity" asp-page="/Account/Login">Log in</a> to join the discussion.</p>
}

<partial name="_CommentList" model="resourceComments.OrderByDescending(c => c.PostedDate)" />
</div>
