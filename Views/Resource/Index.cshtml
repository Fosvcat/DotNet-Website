@model IEnumerable<Geekspace.Models.LearningResource>

@{
    ViewData["Title"] = "Resource";
}

<div class="page-banner">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <!-- EDIT ME: left-side banner text -->
        <span class="page-banner-text">Explore all our articles, assessments and media here</span>

        @if (User.IsInRole("Admin") || User.IsInRole("Root"))
        {
            <a asp-action="Create" class="btn btn-light btn-sm">Create New</a>
        }
    </div>
</div>

@{
    var searchTerm = ViewData["Search"] as string;
}
@if (!string.IsNullOrWhiteSpace(searchTerm))
{
    <p class="text-muted">
        @Model.Count() result(s) for <strong>&ldquo;@searchTerm&rdquo;</strong>.
        <a asp-action="Index">Clear search</a>
    </p>
}

<div class="table-card">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                <div class="description-cell">@Html.DisplayFor(modelItem => item.Description)</div>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                @if (User.IsInRole("Admin") || User.IsInRole("Root"))
                {
                    <a asp-action="Details" asp-route-id="@item.Id">View</a> <text> | </text>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> <text> | </text>
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
                else
                {
                    <a asp-action="Details" asp-route-id="@item.Id">View</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
</div>
