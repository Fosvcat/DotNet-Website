@model IEnumerable<Geekspace.Models.LearningResource>

@{
    ViewData["Title"] = "Resource";
}

<div class="page-banner">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <!-- EDIT ME: left-side banner text -->
        <span class="page-banner-text">Explore all our articles, assessments and media here</span>

        @if (User.IsInRole("Admin") || User.IsInRole("Root"))
        {
            <a asp-action="Create" class="btn btn-light btn-sm">Create New</a>
        }
    </div>
</div>

@{
    var searchTerm = ViewData["Search"] as string;
}
@if (!string.IsNullOrWhiteSpace(searchTerm))
{
    <p class="text-muted">
        @Model.Count() result(s) for <strong>&ldquo;@searchTerm&rdquo;</strong>.
        <a asp-action="Index">Clear search</a>
    </p>
}

<div class="table-card">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td class="text-end">
                <div class="action-btn-group justify-content-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="icon-action-btn icon-view" title="View">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                        </svg>
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Root"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="icon-action-btn icon-edit" title="Edit">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="icon-action-btn icon-delete" title="Delete">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                <line x1="14" y1="11" x2="14" y2="17"></line>
                            </svg>
                        </a>
                    }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
</div>
