@model Geekspace.Models.LearningResource

<article class="python-security-article">
    <header class="python-article-hero">
        <div class="python-article-kicker">
            <span class="python-article-kicker-mark" aria-hidden="true"></span>
            <span>Security Automation Field Guide</span>
            <span class="python-article-version">Article 05</span>
        </div>

        <h1>@Model.Title</h1>
        <p class="python-article-lead">@Model.Description</p>

        <div class="python-article-meta" aria-label="Article information">
            <span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 5.5h16v13H4zM8 3v5M16 3v5M4 9h16"></path>
                </svg>
                @Model.CreatedDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
            </span>
            <span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="12" r="8"></circle>
                    <path d="M12 8v4l3 2"></path>
                </svg>
                12 min read
            </span>
            <span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 18V9M10 18V5M16 18v-7M22 18H2"></path>
                </svg>
                Intermediate
            </span>
            <span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"></path>
                </svg>
                @(Model.Category?.Name ?? "Programming for Security")
            </span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.MediaUrl))
    {
        <section class="python-article-visual" aria-labelledby="python-visual-caption">
            <figure>
                <div class="python-article-image-frame">
                    <img src="@Model.MediaUrl"
                         alt="Benefits of using Python for cybersecurity automation"
                         loading="eager" />
                </div>
                <figcaption id="python-visual-caption">
                    <span class="python-caption-label">Visual brief</span>
                    Python combines readable syntax, a mature ecosystem and rapid iteration for security workflows.
                </figcaption>
            </figure>
        </section>
    }

    <div class="python-reading-layout">
        <aside class="python-article-toc" aria-label="On this page">
            <p>On this page</p>
            <nav>
                <a href="#python-overview"><span>01</span> Why Python</a>
                <a href="#python-principles"><span>02</span> Secure patterns</a>
                <a href="#python-pipeline"><span>03</span> Automation pipeline</a>
                <a href="#python-check"><span>04</span> Knowledge check</a>
            </nav>
            <div class="python-toc-note">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3 4 7v5c0 4.6 3.1 7.8 8 9 4.9-1.2 8-4.4 8-9V7z"></path>
                    <path d="m9 12 2 2 4-4"></path>
                </svg>
                <span>Use only on systems you own or are explicitly authorized to test.</span>
            </div>
        </aside>

        <div class="python-article-body">
            <section id="python-overview" class="python-content-section">
                <div class="python-section-heading">
                    <span>01</span>
                    <div>
                        <p>Operational advantage</p>
                        <h2>Why Python dominates security automation</h2>
                    </div>
                </div>

                <p>
                    Security work is full of repeatable decisions: collect evidence, normalize it,
                    enrich it and route the result. Python is effective here because its readable
                    syntax keeps intent visible while its libraries shorten the path from an idea
                    to a reviewed, testable tool.
                </p>

                <div class="python-insight-grid">
                    <article>
                        <span class="python-insight-icon" aria-hidden="true">01</span>
                        <h3>Fast iteration</h3>
                        <p>Prototype an investigation workflow quickly, then harden it with tests and validation.</p>
                    </article>
                    <article>
                        <span class="python-insight-icon" aria-hidden="true">02</span>
                        <h3>Readable logic</h3>
                        <p>Clear control flow makes peer review and incident-time maintenance less error-prone.</p>
                    </article>
                    <article>
                        <span class="python-insight-icon" aria-hidden="true">03</span>
                        <h3>Broad ecosystem</h3>
                        <p>Work with APIs, structured logs, files and network services using mature libraries.</p>
                    </article>
                </div>
            </section>

            <section id="python-principles" class="python-content-section">
                <div class="python-section-heading">
                    <span>02</span>
                    <div>
                        <p>Engineering discipline</p>
                        <h2>Build scripts that are safe to operate</h2>
                    </div>
                </div>

                <p>
                    A useful security script is more than code that works once. It should fail
                    predictably, protect secrets, leave an audit trail and make its operating scope explicit.
                </p>

                <div class="python-practice-list">
                    <article>
                        <div class="python-practice-mark" aria-hidden="true">ENV</div>
                        <div>
                            <h3>Isolate dependencies</h3>
                            <p>Use a virtual environment and pin reviewed dependency versions for reproducible execution.</p>
                        </div>
                    </article>
                    <article>
                        <div class="python-practice-mark" aria-hidden="true">KEY</div>
                        <div>
                            <h3>Keep secrets out of source</h3>
                            <p>Load credentials from environment variables or an approved secrets vault, never from literals.</p>
                        </div>
                    </article>
                    <article>
                        <div class="python-practice-mark" aria-hidden="true">LOG</div>
                        <div>
                            <h3>Design for auditability</h3>
                            <p>Emit structured logs with timestamps, severity, task identifiers and a clear final outcome.</p>
                        </div>
                    </article>
                    <article>
                        <div class="python-practice-mark" aria-hidden="true">T/O</div>
                        <div>
                            <h3>Bound external operations</h3>
                            <p>Add timeouts, limited retries and exponential backoff to network and subprocess calls.</p>
                        </div>
                    </article>
                </div>

                <aside class="python-callout">
                    <div class="python-callout-icon" aria-hidden="true">!</div>
                    <div>
                        <strong>Operator note</strong>
                        <p>
                            Prefer argument lists with <code>shell=False</code> when launching processes.
                            Validate targets against an approved scope before any scan or collection task begins.
                        </p>
                    </div>
                </aside>
            </section>

            <section id="python-pipeline" class="python-content-section">
                <div class="python-section-heading">
                    <span>03</span>
                    <div>
                        <p>Reference workflow</p>
                        <h2>A small, auditable automation pipeline</h2>
                    </div>
                </div>

                <p>
                    A daily security report can be modeled as four explicit stages. Keeping the stages
                    separate makes failures easier to locate and each transformation easier to test.
                </p>

                <ol class="python-pipeline">
                    <li>
                        <span>01</span>
                        <div><strong>Collect</strong><small>Approved asset inventory and JSON event logs</small></div>
                    </li>
                    <li>
                        <span>02</span>
                        <div><strong>Normalize</strong><small>Validate required fields and timestamps</small></div>
                    </li>
                    <li>
                        <span>03</span>
                        <div><strong>Analyze</strong><small>Aggregate indicators and flag policy thresholds</small></div>
                    </li>
                    <li>
                        <span>04</span>
                        <div><strong>Report</strong><small>Store results and notify the security team</small></div>
                    </li>
                </ol>

                <div class="python-code-card">
                    <div class="python-code-toolbar">
                        <span><i></i><i></i><i></i></span>
                        <span>failed_logins.py</span>
                        <span>PYTHON 3</span>
                    </div>
<pre><code>import json
from collections import Counter
from pathlib import Path

def summarize_failed_logins(log_path: Path) -&gt; Counter:
    counts = Counter()
    with log_path.open(encoding="utf-8") as stream:
        for line in stream:
            event = json.loads(line)
            if event.get("result") == "failed":
                counts[event.get("source_ip", "unknown")] += 1
    return counts</code></pre>
                </div>

                <p class="python-code-caption">
                    Keep parsing deterministic and return data instead of sending alerts directly;
                    notification logic can then be tested independently.
                </p>
            </section>

            <section id="python-check" class="python-content-section python-knowledge-section">
                <div class="python-section-heading">
                    <span>04</span>
                    <div>
                        <p>Knowledge check</p>
                        <h2>Apply the operating principles</h2>
                    </div>
                </div>

                <p>Choose the strongest answer for each scenario, then check your result.</p>

                <form class="python-quiz" data-security-quiz>
                    <fieldset class="python-question" data-correct-answer="vault">
                        <legend>
                            <span>Question 01</span>
                            A scheduled script needs an API credential. Where should it be stored?
                        </legend>
                        <label><input type="radio" name="python-q1" value="source" /> Directly in the source file</label>
                        <label><input type="radio" name="python-q1" value="vault" /> In an approved secrets vault or protected environment variable</label>
                        <label><input type="radio" name="python-q1" value="log" /> In the first line of the audit log</label>
                        <p class="python-question-feedback" aria-live="polite"></p>
                    </fieldset>

                    <fieldset class="python-question" data-correct-answer="arguments">
                        <legend>
                            <span>Question 02</span>
                            Which subprocess pattern best reduces shell-injection risk?
                        </legend>
                        <label><input type="radio" name="python-q2" value="string" /> Build one command string from user input</label>
                        <label><input type="radio" name="python-q2" value="arguments" /> Pass a validated argument list with <code>shell=False</code> and a timeout</label>
                        <label><input type="radio" name="python-q2" value="retry" /> Retry the same shell command until it succeeds</label>
                        <p class="python-question-feedback" aria-live="polite"></p>
                    </fieldset>

                    <fieldset class="python-question" data-correct-answer="separate">
                        <legend>
                            <span>Question 03</span>
                            Why should the log parser return structured results instead of sending alerts itself?
                        </legend>
                        <label><input type="radio" name="python-q3" value="faster" /> It guarantees every file will process faster</label>
                        <label><input type="radio" name="python-q3" value="smaller" /> It makes the Python installation smaller</label>
                        <label><input type="radio" name="python-q3" value="separate" /> It separates responsibilities so parsing and notification can be tested independently</label>
                        <p class="python-question-feedback" aria-live="polite"></p>
                    </fieldset>

                    <div class="python-quiz-actions">
                        <button type="button" class="python-quiz-submit" data-quiz-submit>Check answers</button>
                        <p class="python-quiz-result" data-quiz-result aria-live="polite"></p>
                    </div>
                </form>
            </section>
        </div>
    </div>
</article>
