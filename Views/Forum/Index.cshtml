@model List<Geekspace.Models.ResourceComment>

@{
    ViewData["Title"] = "Forum";
}

<div class="page-banner">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <!-- EDIT ME: left-side banner text -->
        <span class="page-banner-text">Public discussion forum</span>
        <span class="page-banner-text">@Model.Count() posts</span>
    </div>
</div>

<hr />

@if (TempData["CommentError"] != null)
{
    <div class="alert alert-danger">@TempData["CommentError"]</div>
}

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <form asp-controller="Comment" asp-action="Create" method="post" class="mb-4">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <textarea name="content" class="form-control" rows="3" placeholder="Share your thoughts..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary mt-2">Post</button>
    </form>
}
else
{
    <p><a asp-area="Identity" asp-page="/Account/Login">Log in</a> to join the discussion.</p>
}

<partial name="_CommentList" model="Model" />
