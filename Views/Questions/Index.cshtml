@model IReadOnlyList<Geekspace.Models.QuizContent>

@{
    ViewData["Title"] = "Questions";
}

<div class="page-banner">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="page-banner-text">Test your knowledge with quick multiple-choice checks</span>
        <span class="page-banner-text">@Model.Count Questions</span>
    </div>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var quiz in Model)
    {
        <div class="col">
            <a asp-action="Details" asp-route-id="@quiz.Id" class="quiz-card-link">
                <article class="quiz-card">
                    <div class="quiz-card-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 2-3 4"></path>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                            <circle cx="12" cy="12" r="10"></circle>
                        </svg>
                    </div>
                    <span class="quiz-card-badge">@quiz.Questions.Length questions</span>
                    <h2 class="quiz-card-title">@quiz.Title</h2>
                    <p class="quiz-card-description">@quiz.Description</p>
                </article>
            </a>
        </div>
    }
</div>
