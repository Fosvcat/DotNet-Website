@model IEnumerable<Geekspace.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="page-banner">
    <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
        <!-- EDIT ME: left-side banner text -->
        <span class="page-banner-text">Useful materials and information</span>

        @if (User.IsInRole("Admin") || User.IsInRole("Root"))
        {
            <a asp-action="Create" class="site-action-btn site-action-create site-action-on-banner">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 5v14M5 12h14"></path>
                </svg>
                <span>Create New</span>
            </a>
        }
    </div>
</div>

<div class="table-card category-table-card">
<div class="table-responsive">
<table class="table category-table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th class="category-actions-heading" scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td><div class="category-description-cell">@Html.DisplayFor(modelItem => item.Description)</div></td>
                <td class="category-actions-cell">
                    <div class="site-action-group" role="group" aria-label="Actions for @item.Name">
                    @if (User.IsInRole("Admin") || User.IsInRole("Root"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="site-action-btn site-action-edit"
                           aria-label="Edit @item.Name">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 20h9"></path>
                                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
                            </svg>
                            <span>Edit</span>
                        </a>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id" class="site-action-btn site-action-view"
                       aria-label="View details for @item.Name">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                            <circle cx="12" cy="12" r="2.5"></circle>
                        </svg>
                        <span>Details</span>
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Root"))
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id" class="site-action-btn site-action-delete"
                           aria-label="Delete @item.Name">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M3 6h18"></path>
                                <path d="M8 6V4h8v2"></path>
                                <path d="M19 6l-1 14H6L5 6"></path>
                                <path d="M10 11v5M14 11v5"></path>
                            </svg>
                            <span>Delete</span>
                        </a>
                    }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
</div>
