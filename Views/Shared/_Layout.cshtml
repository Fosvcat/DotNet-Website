<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <script>
    (function () {
        var savedTheme = localStorage.getItem('geekspace-theme');
        document.documentElement.setAttribute('data-bs-theme', savedTheme || 'light');
    })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="view-transition" content="same-origin" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>@ViewData["Title"] - Geekspace</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Geekspace.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        // Particle background is only shown on the four "root" browsing
        // pages, never on Details/Edit/Create/Delete or account pages.
        // Resource's Search results reuse the Index view, so it's
        // included too for visual consistency with plain browsing.
        bool showParticleBackground =
            (currentController == "Home" && currentAction == "Index") ||
            (currentController == "Resource" && (currentAction == "Index" || currentAction == "Search")) ||
            (currentController == "Category" && currentAction == "Index") ||
            (currentController == "Forum" && currentAction == "Index");
    }
    @if (showParticleBackground)
    {
        <canvas id="themeAmbientCanvas" class="theme-ambient-canvas" aria-hidden="true"></canvas>
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Geekspace</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark @(currentController == "Resource" ? "active-nav-link" : "")" asp-area="" asp-controller="Resource" asp-action="Index">Resources</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(currentController == "Category" ? "active-nav-link" : "")" asp-area="" asp-controller="Category" asp-action="Index">Categories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(currentController == "Questions" ? "active-nav-link" : "")" asp-area="" asp-controller="Questions" asp-action="Index">Questions</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(currentController == "Forum" ? "active-nav-link" : "")" asp-area="" asp-controller="Forum" asp-action="Index">Forum</a>
                            </li>
                        </ul>

                        <div class="d-flex align-items-center">
                            <form class="gs-search me-2" role="search" method="get" asp-controller="Resource" asp-action="Search">
                                <span class="gs-search-icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="11" cy="11" r="7"></circle>
                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                    </svg>
                                </span>
                                <input type="search" name="q" class="gs-search-input" placeholder="Search..."
                                       aria-label="Search resources" value="@Context.Request.Query["q"]" />
                            </form>
                            <button id="themeToggle" class="btn theme-toggle-btn me-2" type="button" title="Toggle light / dark theme">
                                <svg class="icon-sun" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="5"></circle>
                                    <line x1="12" y1="1" x2="12" y2="3"></line>
                                    <line x1="12" y1="21" x2="12" y2="23"></line>
                                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                                    <line x1="1" y1="12" x2="3" y2="12"></line>
                                    <line x1="21" y1="12" x2="23" y2="12"></line>
                                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                                </svg>
                                <svg class="icon-moon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                                </svg>
                            </button>
                            @await Component.InvokeAsync("NotificationBell")
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            <p class="small mb-2">
                Geekspace brings together articles, videos and assessments
                for people learning Cybersecurity and technology skills.
            </p>
            <div class="d-flex justify-content-between flex-wrap">
                <span>&copy; 2026 - Geekspace - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></span>
                <small>Developed with ASP.NET Core and SQLite</small>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggleBtn = document.getElementById('themeToggle');
            var html = document.documentElement;

            function applyTheme(next) {
                html.setAttribute('data-bs-theme', next);
                localStorage.setItem('geekspace-theme', next);
            }

            toggleBtn.addEventListener('click', function (event) {
                var next = html.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';

                // Fallback for browsers without View Transitions support
                // (e.g. older Firefox/Safari): switch instantly, no circular reveal.
                if (!document.startViewTransition) {
                    applyTheme(next);
                    return;
                }

                var rect = toggleBtn.getBoundingClientRect();
                var xPercent = ((rect.left + rect.width / 2) / window.innerWidth) * 100;
                var yPercent = ((rect.top + rect.height / 2) / window.innerHeight) * 100;

                // Percentages, not pixels, on purpose: Chrome's
                // view-transition pseudo-element box does not always
                // correspond 1:1 with actual viewport pixels, which made
                // pixel-based clip-path values land in the wrong spot and
                // stop short of full coverage. Percentages are always
                // resolved relative to the pseudo-element's own box, so
                // they stay correct regardless of its actual rendered size.
                html.style.setProperty('--reveal-x', xPercent + '%');
                html.style.setProperty('--reveal-y', yPercent + '%');

                // Also disable all CSS color transitions for the duration of
                // the theme switch, so elements with their own background/
                // color transitions can't be snapshotted mid-fade.
                html.classList.add('theme-transitioning');

                var transition = document.startViewTransition(function () {
                    applyTheme(next);
                });

                transition.finished.then(function () {
                    html.classList.remove('theme-transitioning');
                    html.style.removeProperty('--reveal-x');
                    html.style.removeProperty('--reveal-y');
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
